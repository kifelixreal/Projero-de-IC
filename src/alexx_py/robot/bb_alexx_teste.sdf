<?xml version="1.0" ?>
<sdf version='1.9'>
  <model name='Axe-LL' canonical_link="chassi_link">
    
    <!-- Frames auxiliares -->
    <frame name="caster_frame" attached_to="chassi_link">
        <pose>0.18 0 -0.17 0 0 0</pose>
    </frame>
    <frame name="lidar_frame" attached_to='chassi_link'>
    <pose>0.8 0 0.5 0 0 0</pose>
</frame>
    
    <!-- Link do chassi -->
    <link name='chassi_link'>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>file:///home/kifelix/Blender Objetos/prototipo 1 (Axe-LL_ Adaptable Xenon Explorer_ Logistics Line-follower)/Chassi_sem_roda.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name='collision'>
        <geometry>
          <mesh>
            <uri>file:///home/kifelix/Blender Objetos/prototipo 1 (Axe-LL_ Adaptable Xenon Explorer_ Logistics Line-follower)/Chassi_sem_roda.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>10.0</mass>
        <inertia>
          <ixx>0.15</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.2833</iyy>
          <iyz>0</iyz>
          <izz>0.2833</izz>
        </inertia>
      </inertial>
      <enable_wind>false</enable_wind>
      <sensor name="imu_sensor" type="imu">
	  <pose>0 0 0 0 0 0</pose>
	  <topic>imu</topic>	
	  <imu>
	    <angular_velocity>
	      <noise>
		<type>gaussian</type>
		<mean>0.0</mean>
		<stddev>0.01</stddev>
	      </noise>
	    </angular_velocity>
	    <linear_acceleration>
	      <noise>
		<type>gaussian</type>
		<mean>0.0</mean>
		<stddev>0.01</stddev>
	      </noise>
	    </linear_acceleration>
	    <orientation>
	      <noise>
		<type>gaussian</type>
		<mean>0.0</mean>
		<stddev>0.01</stddev>
	      </noise>
	    </orientation>
	  </imu>
	  <plugin filename="ignition_ros2_imu_sensor" name="imu_sensor_plugin">
	    <ros>
	      <namespace>/</namespace>
	      <remapping>~/imu_sensor:=/imu_sensor</remapping>
	    </ros>
	    <update_rate>50.0</update_rate>
	  </plugin>
	</sensor>
    </link>

    <!-- Link roda direita -->
    <link name='rodaD_link'>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>file:///home/kifelix/Blender Objetos/prototipo 1 (Axe-LL_ Adaptable Xenon Explorer_ Logistics Line-follower)/roda(geral).dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name='collision'>
        <geometry>
          <mesh>
            <uri>file:///home/kifelix/Blender Objetos/prototipo 1 (Axe-LL_ Adaptable Xenon Explorer_ Logistics Line-follower)/roda(geral).dae</uri>
          </mesh>
        </geometry>
      </collision>
      <pose>-0.1264 -0.1751 -0.1 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>8</mass>
        <inertia>
	    <ixx>0.0217</ixx>
	    <ixy>0</ixy>
	    <ixz>0</ixz>
	    <iyy>0.04</iyy>
	    <iyz>0</iyz>
	    <izz>0.0217</izz>
        </inertia>
      </inertial>
      <enable_wind>false</enable_wind>
    </link>

    <!-- Link roda Esquerda -->
    <link name='rodaE_link'>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>file:///home/kifelix/Blender Objetos/prototipo 1 (Axe-LL_ Adaptable Xenon Explorer_ Logistics Line-follower)/roda(geral).dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name='collision'>
        <geometry>
          <mesh>
            <uri>file:///home/kifelix/Blender Objetos/prototipo 1 (Axe-LL_ Adaptable Xenon Explorer_ Logistics Line-follower)/roda(geral).dae</uri>
          </mesh>
        </geometry>
      </collision>
      <pose>-0.1264 0.1751 -0.1 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>8</mass>
        <inertia>
	    <ixx>0.0217</ixx>
	    <ixy>0</ixy>
	    <ixz>0</ixz>
	    <iyy>0.04</iyy>
	    <iyz>0</iyz>
	    <izz>0.0217</izz>
        </inertia>
      </inertial>
      <enable_wind>false</enable_wind>	
    </link>
    
    <!-- Roda Boba -->
    <link name="caster">
        <pose relative_to="caster_frame"/>
        <inertial>
          <mass>1</mass>
          <inertia>
            <ixx>0.016</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.016</iyy><iyz>0</iyz><izz>0.016</izz>
          </inertia>
        </inertial>
        <visual name="visual">
          <geometry><sphere><radius>0.027</radius></sphere></geometry>
          <material><ambient>0 1 0 1</ambient><diffuse>0 1 0 1</diffuse><specular>0 1 0 1</specular></material>
        </visual>
        <collision name="collision">
          <geometry><sphere><radius>0.027</radius></sphere></geometry>
        </collision>
    </link>
	
	<link name='link_lidar'>
                <pose relative_to="camera_rgb_0_link">0 0 0.015 0 0 0</pose>
                <inertial>
                    <mass>0.1</mass>
                    <inertia>
                        <ixx>0</ixx>
                        <ixy>0</ixy>
                        <ixz>0</ixz>
                        <iyy>0</iyy>
                        <iyz>0</iyz>
                        <izz>0</izz>
                    </inertia>
                </inertial>
                <visual name='visual'>
                    <geometry>
                        <cylinder>
                            <radius>0.005</radius>
                            <length>0.01</length>
                        </cylinder>
                    </geometry>
                    <material>
                        <ambient>1.0 0.0 0.0 1</ambient>
                        <diffuse>1.0 0.0 0.0 1</diffuse>
                        <specular>1.0 0.0 0.0 1</specular>
                    </material>
                </visual>
                <collision name='collision'>
                    <geometry>
                        <cylinder>
                            <radius>0.005</radius>
                            <length>0.01</length>
                        </cylinder>
                    </geometry>
                </collision>
                <sensor name='gpu_lidar' type='gpu_lidar'>"
		    <pose relative_to='link_lidar'>0 0 0 0 0 0</pose>
		    <topic>lidar</topic>
		    <update_rate>10</update_rate>
		    <ray>
			<scan>
			    <horizontal>
				<samples>640</samples>
				<resolution>1</resolution>
				<min_angle>-1.396263</min_angle>
				<max_angle>1.396263</max_angle>
			    </horizontal>
			    <vertical>
				<samples>1</samples>
				<resolution>0.01</resolution>
				<min_angle>0</min_angle>
				<max_angle>0</max_angle>
			    </vertical>
			</scan>
			<range>
			    <min>0.08</min>
			    <max>10.0</max>
			    <resolution>0.01</resolution>
			</range>
		    </ray>
		    <always_on>1</always_on>
		    <visualize>true</visualize>
		</sensor>
            </link>
	<link name="modulo_sensor_0_link">
	  <visual name="visual">
	    <geometry>
	      <mesh>
		<uri>file:///home/kifelix/Blender Objetos/prototipo 1 (Axe-LL_ Adaptable Xenon Explorer_ Logistics Line-follower)/modulo_sensor_0.dae</uri>
	      </mesh>
	    </geometry>
	  </visual>
	  <collision name="collision">
	    <geometry>
	      <mesh>
		<uri>file:///home/kifelix/Blender Objetos/prototipo 1 (Axe-LL_ Adaptable Xenon Explorer_ Logistics Line-follower)/modulo_sensor_0.dae</uri>
	      </mesh>
	    </geometry>
	  </collision>
	  <pose>0.226734 0 -0.155 3.14159 0.064482 3.14159</pose>
	  <inertial>
	    <pose>0 0 0 0 0 0</pose>
	    <mass>0.1</mass>
	    <inertia>
	      <ixx>1</ixx>
	      <ixy>0</ixy>
	      <ixz>0</ixz>
	      <iyy>1</iyy>
	      <iyz>0</iyz>
	      <izz>1</izz>
	    </inertia>
	  </inertial>
	  <enable_wind>false</enable_wind>
	  <!-- Sensores infravermelhos -->
	  <sensor name="sensor_ray" type="ray">
          <ray>
            <scan>
              <horizontal>
                <samples>300</samples>
                <resolution>1.0</resolution>
                <min_angle>-0.5236</min_angle>
                <max_angle>0.5236</max_angle>
              </horizontal>
              <vertical>
                <samples>100</samples>
                <resolution>1.0</resolution>
                <min_angle>-0.5236</min_angle>
                <max_angle>0.5236</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.05</min>
              <max>50.0</max>
            </range>
          </ray>
          <always_on>true</always_on>
          <update_rate>1.0</update_rate>
          <plugin name="pc2" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/ray</namespace>
              <remapping>~/out:=pointcloud2</remapping>
            </ros>
            <output_type>sensor_msgs/PointCloud2</output_type>
          </plugin>
          <plugin name="pc" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/ray</namespace>
              <remapping>~/out:=pointcloud</remapping>
            </ros>
            <output_type>sensor_msgs/PointCloud</output_type>
          </plugin>
          <plugin name="laserscan" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/ray</namespace>
              <remapping>~/out:=laserscan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
          </plugin>
          <plugin name="range" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/ray</namespace>
              <remapping>~/out:=range</remapping>
            </ros>
            <output_type>sensor_msgs/Range</output_type>
          </plugin>
        </sensor>

        <!-- gpu_ray sensor producing PointCloud / LaserScan -->
        <sensor name="sensor_gpu_ray" type="gpu_ray">
          <ray>
            <scan>
              <horizontal>
                <samples>300</samples>
                <resolution>1.0</resolution>
                <min_angle>-0.5236</min_angle>
                <max_angle>0.5236</max_angle>
              </horizontal>
              <!--
              gpu_ray currently only supports 1 vertical ray (no vertical tag)
              See https://bitbucket.org/osrf/gazebo/issues/2486
              <vertical>
                <samples>100</samples>
                <resolution>1.0</resolution>
                <min_angle>-0.5236</min_angle>
                <max_angle>0.5236</max_angle>
              </vertical-->
            </scan>
            <range>
              <min>0.05</min>
              <max>50.0</max>
            </range>
          </ray>
          <always_on>true</always_on>
          <update_rate>1.0</update_rate>
          <plugin name="pc2_gpu" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/gpu_ray</namespace>
              <remapping>~/out:=pointcloud2</remapping>
            </ros>
            <output_type>sensor_msgs/PointCloud2</output_type>
          </plugin>
          <plugin name="pc_gpu" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/gpu_ray</namespace>
              <remapping>~/out:=pointcloud</remapping>
            </ros>
            <output_type>sensor_msgs/PointCloud</output_type>
          </plugin>
          <plugin name="laserscan_gpu" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/gpu_ray</namespace>
              <remapping>~/out:=laserscan</remapping>
            </ros>
            <output_type>sensor_msgs/LaserScan</output_type>
          </plugin>
          <plugin name="range_gpu" filename="libgazebo_ros_ray_sensor.so">
            <ros>
              <namespace>/gpu_ray</namespace>
              <remapping>~/out:=range</remapping>
            </ros>
            <output_type>sensor_msgs/Range</output_type>
          </plugin>
        </sensor>
	</link>
      
    <!-- Link câmera RGB -->
    <link name='camera_rgb_0_link'>
      <visual name='visual'>
        <geometry>
          <mesh>
            <uri>file:///home/kifelix/Blender Objetos/prototipo 1 (Axe-LL_ Adaptable Xenon Explorer_ Logistics Line-follower)/camera_rgb.dae</uri>
          </mesh>
        </geometry>
      </visual>
      <collision name='collision'>
        <geometry>
          <mesh>
            <uri>file:///home/kifelix/Blender Objetos/prototipo 1 (Axe-LL_ Adaptable Xenon Explorer_ Logistics Line-follower)/camera_rgb.dae</uri>
          </mesh>
        </geometry>
      </collision>
      <pose>0.1791 0 0.315 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>0.1</mass>
        <inertia>
          <ixx>1</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>1</iyy>
          <iyz>0</iyz>
          <izz>1</izz>
        </inertia>
      </inertial>
      <enable_wind>false</enable_wind>
      
      <sensor name="camera_sensor" type="camera">
    	
    	<pose>0 0 0 0 0 0</pose>
    	<topic>camera</topic>
    	<camera>
      	<horizontal_fov>1.047</horizontal_fov>
      	<image>
        	<width>640</width>
        	<height>480</height>
        	<format>R8G8B8</format>
      	</image>
      	<clip>
        	<near>0.1</near>
        	<far>100</far>
      	</clip>
    	</camera>
    	<update_rate>60</update_rate>
    	
  	</sensor>
    </link>    
    
    <!-- Joints revolute para rodas girarem -->
    <joint name="junta_roda_esquerda" type="revolute">
        <pose relative_to="rodaE_link"/>
        <parent>chassi_link</parent>
        <child>rodaE_link</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
        <dynamics>
	  <damping>0.1</damping>
	  <friction>0.01</friction> <!-- atrito no eixo -->
	</dynamics>
    </joint>

    <joint name="junta_roda_direita" type="revolute">
        <pose relative_to="rodaD_link"/>
        <parent>chassi_link</parent>
        <child>rodaD_link</child>
        <axis>
          <xyz expressed_in="__model__">0 1 0</xyz>
          <limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit>
        </axis>
        <dynamics>
	   <damping>0.1</damping>
	   <friction>0.01</friction> <!-- atrito no eixo -->
	</dynamics>
        
    </joint>
    
    <joint name="caster_wheel" type="ball">
        <parent>chassi_link</parent>
        <child>caster</child>
    </joint>
    
    <!-- Joints fixos para prender sensor e câmera ao chassi -->
    <joint name='joint_modulo_sensor_0' type='fixed'>
      <parent>chassi_link</parent>
      <child>modulo_sensor_0_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <joint name='joint_camera_rgb_0' type='fixed'>
      <parent>chassi_link</parent>
      <child>camera_rgb_0_link</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>
    
    <joint name='joint_lidar' type='fixed'>
      <parent>joint_camera_rgb_0</parent>
      <child>link_lidar</child>
      <pose>0 0 0 0 0 0</pose>
    </joint>

    <pose>-0 0 0.6746 0.009576 -0.027528 0.012258</pose>
    <static>false</static>
    <self_collide>false</self_collide>
    
    <!-- Plugins do modelo -->
      <plugin filename="libignition-gazebo-diff-drive-system.so" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>junta_roda_esquerda</left_joint>
        <right_joint>junta_roda_direita</right_joint>
        <wheel_separation>0.32</wheel_separation>
        <wheel_radius>0.2</wheel_radius>
        <odom_publish_frequency>60</odom_publish_frequency>
        <topic>/cmd_vel</topic>
        <odom_topic>/odom</odom_topic>
      </plugin>
      
      <!--<plugin name="joint_state_publisher" filename="libgazebo_ros_joint_state_publisher.so">
	  <ros>
	    <namespace>/</namespace>
	  </ros>
	  <update_rate>50.0</update_rate>
	</plugin>-->
	
      <plugin name="camera_controller" filename="libignition-gazebo-camera-system.so"/>
      <!--<plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors"> <render_engine>ogre2</render_engine> </plugin>
      <!--<plugin filename="libignition-gazebo6-sensors-system.so" name="ignition::gazebo::systems::Sensors"/>-->
            
      <plugin filename="libignition-gazebo-triggered-publisher-system.so" name="ignition::gazebo::systems::TriggeredPublisher">
        <input type="ignition.msgs.Boolean" topic="/wall/touched">
          <match>data: true</match>
        </input>
        <output type="ignition.msgs.Twist" topic="/cmd_vel">
          linear: {x: 0.0}, angular: {z: 0.0}
        </output>
      </plugin>
      <plugin filename="libignition-gazebo-imu-system.so"
          name="ignition::gazebo::systems::Imu">
      </plugin> 
      <plugin filename="ignition-gazebo-joint-state-publisher-system" name="ignition::gazebo::systems::JointStatePublisher"/>
  </model>
</sdf>
